# ==========================================
# CofiRutas - Root Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=cofi_user
POSTGRES_PASSWORD=cofi_password
POSTGRES_DB=cofi_rutas_db
POSTGRES_PORT=5432

# Connection string used by Prisma / Backend
# When running locally outside Docker: localhost
# When running inside Docker compose: postgres
DATABASE_URL=postgresql://cofi_user:cofi_password@localhost:5432/cofi_rutas_db?schema=public

# ------------------------------------------
# Backend Service (NestJS)
# ------------------------------------------
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Authentication & JWT
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth2 Credentials (Module 1)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ------------------------------------------
# Frontend Service (Next.js)
# ------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
