{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/db/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/db/setup-env.ts"],
  "globalSetup": "<rootDir>/test/db/global-setup.ts",
  "maxWorkers": 1,
  "testTimeout": 30000
}
